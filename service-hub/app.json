{
  "expo": {
    "name": "Service Hub",
    "slug": "service-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.servicehub.app"
    },
    "android": {
      "package": "com.servicehub.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you upload profile and service proof images."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Service Hub to use your location to find nearby verified service providers."
        }
      ]
    ],
    "scheme": "servicehub",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ed6badc-8e19-4c54-bc9a-b5c1391a8221"
      }
    },
    "owner": "akashkrish10"
  }
}
